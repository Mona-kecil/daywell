# Next.js server: fill with your WorkOS application's values.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate a random password of at least 32 characters; never commit it.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Convex dev writes these to ignored .env.local after local setup.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Set these in the Convex deployment environment, not just Next.js.
# WORKOS_CLIENT_ID=<same client ID as above; used by convex/auth.config.ts>
# WORKOS_API_KEY=<same API key; only needed for WorkOS component sync>
MEAL_VISION_PROVIDER=fake
# Leave empty to use DEMO_KEY (30 calls/hour; 50/day).
USDA_FDC_API_KEY=
