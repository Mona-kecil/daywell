# Next.js server: fill with your WorkOS application's values.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate a random password of at least 32 characters; never commit it.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Convex dev writes these to ignored .env.local after local setup.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Set these in the Convex deployment environment, not just Next.js.
# WORKOS_CLIENT_ID=<same client ID as above; used by convex/auth.config.ts>
# WORKOS_API_KEY=<same API key; only needed for WorkOS component sync>
MEAL_VISION_PROVIDER=fake
# OpenAI providers read these names from the Convex environment.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
COACH_CHAT_PROVIDER=
# Quick log defaults to fake; openai uses the same OPENAI_CHAT_MODEL as coach chat.
QUICK_LOG_PROVIDER=fake
OPENAI_CHAT_MODEL=
# Leave empty to use DEMO_KEY (small quota; use fixture mode for local work).
USDA_FDC_API_KEY=
# pnpm dev:setup writes these to .env.local. Never copy them to production.
DEV_AUTH=
DEV_AUTH_PRIVATE_JWK=
# Set on the local Convex deployment by dev:setup:
# DEV_AUTH_JWKS=<public RSA JWKS JSON>
# FDC_MODE=fixture
